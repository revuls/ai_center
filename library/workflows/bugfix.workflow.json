{
  "name": "Bug fix",
  "description": "From a bug report to a verified fix: root cause analysis, reproduction, minimal fix with regression test and review.",
  "icon": "🐞",
  "tags": [
    "dev",
    "qa",
    "bugs"
  ],
  "audience": [
    "dev",
    "qa"
  ],
  "targets": [
    "copilot",
    "claude",
    "any"
  ],
  "status": "stable",
  "version": "1.0.0",
  "author": "AI Center",
  "updated": "2026-10-24",
  "inputs": [
    {
      "name": "symptoms",
      "label": "Symptoms",
      "description": "What happens, what was expected and since when",
      "required": true
    },
    {
      "name": "logs",
      "label": "Logs / traces",
      "description": "Optional",
      "required": false
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "title": "Start",
      "x": 40,
      "y": 200
    },
    {
      "id": "analyze",
      "type": "step",
      "title": "Analyze the bug",
      "agent": "developer",
      "prompt": "analyze-bug",
      "outputKey": "analysis",
      "x": 260,
      "y": 180
    },
    {
      "id": "repro",
      "type": "condition",
      "title": "Reproducible?",
      "question": "Does the analysis say the bug is REPRODUCIBLE with the available information?",
      "x": 560,
      "y": 190
    },
    {
      "id": "more_info",
      "type": "human",
      "title": "Ask for more information",
      "instructions": "Provide the missing information (steps, data, environment, logs) in the comments.",
      "x": 840,
      "y": 340
    },
    {
      "id": "fix",
      "type": "step",
      "title": "Fix with a regression test",
      "agent": "developer",
      "instructions": "First write a test that reproduces the bug, apply the minimal fix based on the analysis:\n\n{{analysis}}\n\nand check that all tests pass.",
      "outputKey": "fix",
      "x": 840,
      "y": 100
    },
    {
      "id": "review",
      "type": "step",
      "title": "Review",
      "agent": "code-reviewer",
      "instructions": "Review the fix and the regression test. Check for side effects.",
      "x": 1130,
      "y": 100
    },
    {
      "id": "ok",
      "type": "human",
      "title": "Approve the fix",
      "instructions": "Validate the fix before merging it.",
      "x": 1420,
      "y": 110
    },
    {
      "id": "end",
      "type": "end",
      "title": "Bug fixed",
      "x": 1700,
      "y": 120
    }
  ],
  "edges": [
    {
      "id": "b1",
      "from": "start",
      "to": "analyze"
    },
    {
      "id": "b2",
      "from": "analyze",
      "to": "repro"
    },
    {
      "id": "b3",
      "from": "repro",
      "to": "fix",
      "label": "yes"
    },
    {
      "id": "b4",
      "from": "repro",
      "to": "more_info",
      "label": "no"
    },
    {
      "id": "b5",
      "from": "more_info",
      "to": "analyze"
    },
    {
      "id": "b6",
      "from": "fix",
      "to": "review"
    },
    {
      "id": "b7",
      "from": "review",
      "to": "ok"
    },
    {
      "id": "b8",
      "from": "ok",
      "to": "end",
      "label": "approved"
    },
    {
      "id": "b9",
      "from": "ok",
      "to": "fix",
      "label": "changes"
    }
  ]
}
