{
  "name": "From idea to prioritized backlog",
  "description": "For Product Owners: analyzes an initiative, splits it into stories, defines acceptance criteria and prioritizes with RICE, with business validation.",
  "icon": "🧭",
  "tags": [
    "product",
    "agile"
  ],
  "audience": [
    "po",
    "business"
  ],
  "targets": [
    "copilot",
    "m365",
    "any"
  ],
  "status": "stable",
  "version": "1.0.0",
  "author": "AI Center",
  "updated": "2026-10-24",
  "inputs": [
    {
      "name": "idea",
      "label": "Initiative",
      "required": true
    },
    {
      "name": "goal",
      "label": "Business goal / OKR",
      "required": false
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "title": "Start",
      "x": 40,
      "y": 160
    },
    {
      "id": "stories",
      "type": "step",
      "title": "Stories and criteria",
      "agent": "product-owner",
      "prompt": "refine-idea",
      "outputKey": "stories",
      "x": 260,
      "y": 140
    },
    {
      "id": "prio",
      "type": "step",
      "title": "Prioritize with RICE",
      "agent": "product-owner",
      "prompt": "prioritize-backlog",
      "vars": {
        "items": "{{stories}}"
      },
      "outputKey": "prioritization",
      "x": 560,
      "y": 140
    },
    {
      "id": "biz_ok",
      "type": "human",
      "title": "Business validation",
      "owner": "Stakeholders",
      "x": 860,
      "y": 150
    },
    {
      "id": "end",
      "type": "end",
      "title": "Backlog ready",
      "deliverable": "Prioritized stories ready for technical refinement",
      "x": 1140,
      "y": 160
    }
  ],
  "edges": [
    {
      "id": "i1",
      "from": "start",
      "to": "stories"
    },
    {
      "id": "i2",
      "from": "stories",
      "to": "prio"
    },
    {
      "id": "i3",
      "from": "prio",
      "to": "biz_ok"
    },
    {
      "id": "i4",
      "from": "biz_ok",
      "to": "end",
      "label": "approved"
    },
    {
      "id": "i5",
      "from": "biz_ok",
      "to": "stories",
      "label": "changes"
    }
  ]
}
