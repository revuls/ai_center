{
  "name": "Announced release",
  "description": "Prepares a release: technical release notes, an announcement for business/customers and an executive report, with a review before publishing.",
  "icon": "📣",
  "tags": [
    "product",
    "documentation",
    "business"
  ],
  "audience": [
    "po",
    "business",
    "dev"
  ],
  "targets": [
    "copilot",
    "m365",
    "any"
  ],
  "status": "stable",
  "version": "1.0.0",
  "author": "AI Center",
  "updated": "2026-10-24",
  "inputs": [
    {
      "name": "version",
      "label": "Version",
      "required": true
    },
    {
      "name": "changes",
      "label": "Changes included",
      "description": "Commits, PRs or stories",
      "required": true
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "title": "Start",
      "x": 40,
      "y": 200
    },
    {
      "id": "tech",
      "type": "step",
      "title": "Technical release notes",
      "agent": "tech-writer",
      "prompt": "release-notes",
      "vars": {
        "audience": "technical"
      },
      "outputKey": "technical_notes",
      "x": 260,
      "y": 90
    },
    {
      "id": "biz",
      "type": "step",
      "title": "Business announcement",
      "agent": "business-assistant",
      "prompt": "release-notes",
      "vars": {
        "audience": "business"
      },
      "outputKey": "announcement",
      "x": 260,
      "y": 300
    },
    {
      "id": "exec",
      "type": "step",
      "title": "Executive report",
      "agent": "business-assistant",
      "prompt": "executive-report",
      "vars": {
        "topic": "Version {{version}}",
        "audience": "leadership",
        "data": "{{technical_notes}}\n\n{{announcement}}"
      },
      "context": "all",
      "x": 580,
      "y": 190
    },
    {
      "id": "ok",
      "type": "human",
      "title": "Review before publishing",
      "owner": "Product Owner",
      "x": 880,
      "y": 200
    },
    {
      "id": "end",
      "type": "end",
      "title": "Publish",
      "x": 1160,
      "y": 210
    }
  ],
  "edges": [
    {
      "id": "l1",
      "from": "start",
      "to": "tech"
    },
    {
      "id": "l2",
      "from": "start",
      "to": "biz"
    },
    {
      "id": "l3",
      "from": "tech",
      "to": "exec"
    },
    {
      "id": "l4",
      "from": "biz",
      "to": "exec"
    },
    {
      "id": "l5",
      "from": "exec",
      "to": "ok"
    },
    {
      "id": "l6",
      "from": "ok",
      "to": "end",
      "label": "approved"
    },
    {
      "id": "l7",
      "from": "ok",
      "to": "exec",
      "label": "changes"
    }
  ]
}
