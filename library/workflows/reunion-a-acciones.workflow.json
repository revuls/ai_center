{
  "name": "De reunión a acciones",
  "description": "Convierte una reunión en resumen, plan de acciones y correo de seguimiento listo para enviar. Pensado para Copilot M365 (Teams y Outlook).",
  "icon": "🗒️",
  "tags": [
    "negocio",
    "m365",
    "reuniones"
  ],
  "audience": [
    "negocio",
    "po",
    "todos"
  ],
  "targets": [
    "m365",
    "any"
  ],
  "status": "stable",
  "version": "1.0.0",
  "author": "AI Center",
  "updated": "2026-10-24",
  "inputs": [
    {
      "name": "reunion",
      "label": "Reunión",
      "description": "Nombre/fecha de la reunión en Teams, o pega la transcripción/notas",
      "required": true
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "title": "Inicio",
      "x": 40,
      "y": 160
    },
    {
      "id": "summary",
      "type": "step",
      "title": "Resumir la reunión",
      "agent": "asistente-negocio",
      "prompt": "resumen-reunion",
      "outputKey": "resumen",
      "x": 260,
      "y": 140
    },
    {
      "id": "check",
      "type": "human",
      "title": "Revisar acciones y responsables",
      "instructions": "Comprueba que las acciones, responsables y fechas son correctos.",
      "x": 560,
      "y": 150
    },
    {
      "id": "email",
      "type": "step",
      "title": "Correo de seguimiento",
      "agent": "asistente-negocio",
      "prompt": "email-ejecutivo",
      "vars": {
        "destinatario": "Asistentes de la reunión",
        "objetivo": "Compartir resumen, decisiones y acciones",
        "informacion": "{{resumen}}",
        "tono": "cercano"
      },
      "x": 840,
      "y": 140
    },
    {
      "id": "end",
      "type": "end",
      "title": "Listo para enviar",
      "deliverable": "Resumen + acciones + correo de seguimiento",
      "x": 1130,
      "y": 150
    }
  ],
  "edges": [
    {
      "id": "r1",
      "from": "start",
      "to": "summary"
    },
    {
      "id": "r2",
      "from": "summary",
      "to": "check"
    },
    {
      "id": "r3",
      "from": "check",
      "to": "email",
      "label": "aprobado"
    },
    {
      "id": "r4",
      "from": "check",
      "to": "summary",
      "label": "cambios"
    },
    {
      "id": "r5",
      "from": "email",
      "to": "end"
    }
  ]
}
